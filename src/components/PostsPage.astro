---
import SiteLayout from '../layouts/SiteLayout.astro';
import { Icon } from 'astro-icon/components';
import RecentNotes from './RecentNotes.astro';
import { PAGE_SIZE, type Post } from '../lib/post-data';
interface Props { posts: Post[]; page?: number; }
const { posts, page = 1 } = Astro.props;
const pageCount = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));
const currentPosts = posts.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);
const postsByYear = new Map<number, Post[]>();
for (const post of currentPosts) {
  const year = post.data.pubDate.getUTCFullYear();
  const yearPosts = postsByYear.get(year) ?? [];
  yearPosts.push(post);
  postsByYear.set(year, yearPosts);
}
---
<SiteLayout title={page > 1 ? `笔记 第 ${page} 页` : '笔记'} breadcrumbs={page > 1 ? [{ label: '笔记', href: '/posts/' }, { label: `第 ${page} 页` }] : [{ label: '笔记' }]}>
  <header class="page-heading"><h1>笔记</h1></header>
  {currentPosts.length ? <div class="year-archive">
    {Array.from(postsByYear, ([year, yearPosts]) => <RecentNotes year={year} posts={yearPosts} />)}
  </div> : <div class="empty-state"><p>暂无笔记</p></div>}
  {pageCount > 1 && <nav class="pagination" aria-label="笔记分页">
    {page > 1 ? <a rel="prev" href={page === 2 ? '/posts/' : `/posts/page/${page - 1}/`}><Icon is:inline aria-hidden="true" focusable="false" name="ph:arrow-left" />上一页</a> : <span />}
    <span>第 {page} / {pageCount} 页</span>
    {page < pageCount ? <a rel="next" href={`/posts/page/${page + 1}/`}>下一页<Icon is:inline aria-hidden="true" focusable="false" name="ph:arrow-right" /></a> : <span />}
  </nav>}
</SiteLayout>
<style>
  .year-archive { display: grid; gap: 46px; padding-top: 14px; }
  .pagination { display: grid; grid-template-columns: 1fr auto 1fr; gap: 12px; align-items: center; margin-top: 31px; font-size: .8125rem; color: var(--muted); }
  .pagination > :last-child { justify-self: end; }
  .pagination a { display: inline-flex; align-items: center; gap: 6px; padding: 8px 0; }
</style>
