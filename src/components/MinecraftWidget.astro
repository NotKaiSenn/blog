---
import '../../widgets/minecraft/season-picker.css';

const publicAssets = import.meta.env.PUBLIC_MINECRAFT_WIDGET_ASSET_BASE?.trim();
const assetBase = publicAssets
  ? `${publicAssets.replace(/\/+$/, '')}/`
  : `${import.meta.env.BASE_URL.replace(/\/$/, '')}/minecraft-widget/assets/`;
---
<minecraft-season-picker>
    <minecraft-widget season="spring" asset-base={assetBase}></minecraft-widget>
    <div class="minecraft-seasons" role="group" aria-label="Season" lang="en">
      <button type="button" data-season="spring" aria-label="Spring" aria-pressed="true"><img src={`${assetBase}block/oxeye_daisy.png`} width="32" height="32" alt="" draggable="false" /></button>
      <button type="button" data-season="summer" aria-label="Summer" aria-pressed="false"><img src={`${assetBase}item/melon_slice.png`} width="32" height="32" alt="" draggable="false" /></button>
      <button type="button" data-season="autumn" aria-label="Autumn" aria-pressed="false"><img src={`${assetBase}block/brown_mushroom.png`} width="32" height="32" alt="" draggable="false" /></button>
      <button type="button" data-season="winter" aria-label="Winter" aria-pressed="false"><img src={`${assetBase}block/spruce_sapling.png`} width="32" height="32" alt="" draggable="false" /></button>
    </div>
</minecraft-season-picker>

<script>
  function loadWidget() {
    if (document.querySelector('minecraft-season-picker')) void import('../../widgets/minecraft/season-picker.mjs');
  }
  loadWidget();
  document.addEventListener('astro:page-load', loadWidget);
</script>
