---
import SiteLayout from '../layouts/SiteLayout.astro';
import { Icon } from 'astro-icon/components';
import { friends } from '../lib/site-data';
import { linkProps } from '../lib/links';
---
<SiteLayout title="朋友">
  <header class="page-heading"><h1>朋友</h1></header>
  {friends.length > 0 ? <ul class="friend-list">{friends.map(friend => <li>
    <a class="friend-card" {...linkProps(friend.url)}>
      <span class="friend-avatar"><span aria-hidden="true">{Array.from(friend.name)[0]}</span>{friend.avatar && <img src={friend.avatar} alt="" width="48" height="48" loading="lazy" decoding="async" onerror="this.remove()" />}</span>
      <div class="friend-copy"><h2>{friend.name}</h2>{friend.description && <p>{friend.description}</p>}<span class="friend-address">{friend.host}</span></div>
      <Icon is:inline aria-hidden="true" focusable="false" name="ph:arrow-up-right" class="friend-arrow" />
    </a>
  </li>)}</ul> : <div class="empty-state"><p>暂无链接</p></div>}
</SiteLayout>
<style>
  .friend-list { display: grid; gap: 18px; margin: 0; padding: 0; list-style: none; }
  .friend-card { display: flex; align-items: flex-start; gap: 17px; padding: 23px; border: 1px solid #fff; border-radius: 14px; background: #ffffffb3; box-shadow: 0 3px 9px #26332104, 0 12px 24px #26332105; }
  .friend-avatar { display: grid; place-items: center; width: 54px; height: 54px; flex-shrink: 0; padding: 3px; border-radius: 12px; background: #fff; box-shadow: 0 2px 5px #2633210a; color: var(--green); }
  /* The initial waits beneath the image and shows if the friend's avatar cannot load. */
  .friend-avatar > * { grid-area: 1 / 1; }
  .friend-avatar img { width: 48px; height: 48px; object-fit: contain; border-radius: 9px; background: #fff; }
  .friend-copy { display: block; flex: 1; min-width: 0; }
  h2 { font-size: 1rem; line-height: 1.5; font-weight: 550; overflow-wrap: anywhere; }
  p { margin-top: 5px; color: var(--body); font-size: .875rem; line-height: 1.8; overflow-wrap: anywhere; }
  .friend-address { display: block; margin-top: 6px; color: var(--muted); font-size: .75rem; overflow-wrap: anywhere; }
  .friend-card :global(.friend-arrow) { color: var(--muted); width: 16px; height: 16px; margin-top: 4px; }
  @media (max-width: 479px) { .friend-card { gap: 13px; padding: 18px; } }
</style>
