---
import { Icon } from 'astro-icon/components';
import { responsiveImage } from '../lib/upload-variants';
interface Props { image?: string; width?: number; height?: number; sizes: string; }
const { image, width = 1, height = 1, sizes } = Astro.props;
---
<div class="work-visual" style={`aspect-ratio:${width}/${height}`}>
  {image ? <img class="work-art" src={image} {...responsiveImage(image, width, sizes)} alt="" width={width} height={height} loading="lazy" decoding="async" /> : <Icon is:inline aria-hidden="true" focusable="false" name="ph:stack" class="work-placeholder" />}
</div>
<style>
  .work-visual { display: grid; place-items: center; width: 100%; height: 100%; }
  .work-art { display: block; width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 1px 1px #29322816) drop-shadow(0 6px 8px #2932281a); }
  .work-visual :global(.work-placeholder) { width: 34%; height: auto; color: #94a18a; }
</style>
