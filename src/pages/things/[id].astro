---
import type { GetStaticPaths } from 'astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import ThingShelf from '../../components/ThingShelf.astro';
import type { Thing } from '../../lib/collections';
import { things } from '../../lib/site-data';

export const getStaticPaths = (() => things.map(thing => ({ params: { id: thing.id }, props: { thing } }))) satisfies GetStaticPaths;
interface Props { thing: Thing }
const { thing } = Astro.props;
---
<SiteLayout title={thing.name} description={thing.note ?? [thing.name, thing.brand].filter(Boolean).join(' ')} breadcrumbs={[{ label: '物件', href: '/things/' }, { label: thing.name }]}>
  <header class="page-heading"><h1>物件</h1></header>
  <ThingShelf open={thing.id} listTitle="物件" />
</SiteLayout>
