{
  "name": "kaisenn-blog",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs && npm run test:widget",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "dev:widget": "npm run dev --workspace minecraft-widget",
    "test:widget": "npm test --workspace minecraft-widget"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@iconify-json/ph": "^1.2.2",
    "astro": "^7.3.3",
    "astro-icon": "^1.2.0",
    "hast-util-to-html": "9.0.5",
    "katex": "^0.19.0",
    "mermaid": "^12.1.0",
    "rehype-katex": "^7.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-math": "^6.0.0",
    "satteri": "0.10.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.9.3",
    "yaml": "^2.8.0"
  },
  "workspaces": [
    "widgets/minecraft"
  ],
  "overrides": {
    "katex": "$katex"
  }
}
