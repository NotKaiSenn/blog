---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import NoteDiagrams from '../../components/NoteDiagrams.astro';
import { Icon } from 'astro-icon/components';
import { getPosts } from '../../lib/posts';
import { postDescription, displayDate, isoDate } from '../../lib/post-data';
import katexStylesheet from 'katex/dist/katex.min.css?url';
import '../../styles/prose.css';
export const getStaticPaths = (async () => {
  return (await getPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;
const { post } = Astro.props;
const { Content } = await render(post);
// KaTeX styles and fonts, and the diagram renderer, are only loaded by notes that use them.
const hasMath = post.rendered?.html.includes('class="katex"') ?? true;
const hasDiagrams = post.rendered?.html.includes('language-mermaid') ?? true;
---
<SiteLayout title={post.data.title} description={postDescription(post)} articleDate={post.data.pubDate.toISOString()} breadcrumbs={[{ label: '笔记', href: '/posts/' }, { label: post.data.title }]}>
  {hasMath && <link slot="head" rel="stylesheet" href={katexStylesheet} />}
  <article>
    <header class="page-heading detail-heading">
      <h1>{post.data.title}</h1>
      <time datetime={isoDate(post.data.pubDate)}>{displayDate(post.data.pubDate)}</time>
    </header>
    <div class="prose"><Content /></div>
    {hasDiagrams && <NoteDiagrams />}
    <div class="article-end"><a class="back-link" href="/posts/"><Icon is:inline aria-hidden="true" focusable="false" name="ph:arrow-left" />返回笔记列表</a></div>
  </article>
</SiteLayout>
<style>
  .article-end { margin-top: 53px; padding-top: 26px; border-top: 1px solid var(--line); }
</style>
