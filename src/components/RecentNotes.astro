---
import { postUrl, postDescription, displayDate, isoDate, type Post } from '../lib/post-data';
interface Props { posts: Post[]; year: number; }
const { posts, year } = Astro.props;
const headingId = `notes-year-${year}`;
---
<section class="notes-card" aria-labelledby={headingId}>
  <header class="card-head"><h2 id={headingId}>{year}<span>年</span></h2><span class="year-count">{posts.length} 篇</span></header>
  <ol class="paper-notes">
    {posts.map(post => <li><a class="post-link" href={postUrl(post.id)}>
      <time datetime={isoDate(post.data.pubDate)} aria-label={displayDate(post.data.pubDate)}>{isoDate(post.data.pubDate).slice(5).replace('-', '.')}</time>
      <h3>{post.data.title}</h3><p>{postDescription(post)}</p>
    </a></li>)}
  </ol>
</section>
<style>
  .notes-card { position: relative; width: 100%; padding: 32px 34px 24px; border: 1px solid #00000014; border-radius: 16px 22px 14px 20px; background: linear-gradient(92deg,#fffffff0,#fafafadc),repeating-linear-gradient(180deg,transparent 0 46px,#0000000b 47px 48px); box-shadow: 0 25px 55px #00000012,inset 0 2px #ffffffb8; }
  .notes-card::before { content: ''; position: absolute; left: 70px; top: -17px; width: 132px; height: 38px; border-radius: 4px; background: linear-gradient(90deg,#ffffff57,transparent 26%,#ffffff4d 72%,transparent),#e2e2e2ad; box-shadow: 0 8px 20px #0000000f; transform: rotate(.6deg); pointer-events: none; }
  .card-head { position: relative; display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 17px; }
  .card-head h2 { color: var(--ink); font-size: 24px; font-weight: 600; line-height: 1.4; font-variant-numeric: tabular-nums; letter-spacing: -.025em; }
  .card-head h2 span { margin-left: 7px; font-size: 12px; font-weight: 400; color: var(--muted); letter-spacing: 0; }
  .year-count { color: var(--muted); font-size: 12px; white-space: nowrap; }
  .paper-notes { list-style: none; padding: 0; margin: 0; }
  .post-link { position: relative; display: grid; grid-template-columns: 58px minmax(0,1fr); gap: 7px 14px; padding: 17px 0 17px 16px; border-top: 1px solid var(--line); }
  .post-link::after { content: ''; position: absolute; left: 0; top: 23px; width: 5px; height: 5px; border-radius: 50%; background: var(--ink); opacity: .3; }
  time { color: var(--muted); font-size: 13px; font-weight: 750; line-height: 1.75; font-variant-numeric: tabular-nums; }
  h3 { color: var(--ink); font-size: 16px; font-weight: 650; line-height: 1.42; overflow-wrap: anywhere; }
  .post-link p { grid-column: 2; color: var(--muted); font-size: 13px; line-height: 1.65; overflow-wrap: anywhere; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .post-link:hover h3 { color: var(--ink); text-decoration: underline; text-decoration-thickness: 1px; }
  @media (max-width: 540px) { .notes-card { padding: 28px 18px 18px; } .notes-card::before { left: 36px; width: 116px; } .card-head h2 { font-size: 22px; } .post-link { grid-template-columns: minmax(0,1fr); gap: 8px; } .post-link p { grid-column: auto; } }
</style>
