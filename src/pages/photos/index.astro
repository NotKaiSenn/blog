---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { photoUrl } from '../../lib/collections';
import { photos } from '../../lib/photos';
import { displayDate } from '../../lib/post-data';
---
<SiteLayout title="照片" wide>
  <header class="page-heading"><h1>照片</h1></header>
  {photos.length > 0 ? <photo-masonry><ul class="photo-list">{photos.map(photo => <li>
    <a class="photo-entry" href={photoUrl(photo)}>
      <div class="photo-frame"><img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async" /></div>
      <div class="photo-caption"><h2>{photo.title}</h2><time datetime={photo.date}>{displayDate(new Date(`${photo.date}T00:00:00Z`))}</time></div>
    </a>
  </li>)}</ul></photo-masonry> : <div class="empty-state"><p>暂无照片</p></div>}
</SiteLayout>
<script>
  class PhotoMasonry extends HTMLElement {
    private observer?: ResizeObserver;

    connectedCallback() {
      if (typeof ResizeObserver === 'undefined') return;
      const list = this.querySelector<HTMLElement>('.photo-list');
      const entries = Array.from(this.querySelectorAll<HTMLElement>('.photo-entry'));
      if (!list || !entries.length) return;

      const layout = () => {
        const gap = parseFloat(getComputedStyle(list).getPropertyValue('--photo-gap'));
        const heights = entries.map(entry => Math.ceil(entry.getBoundingClientRect().height + gap));
        entries.forEach((entry, index) => {
          entry.parentElement!.style.gridRowEnd = `span ${heights[index]}`;
        });
        list.classList.add('is-masonry');
      };

      layout();
      this.observer = new ResizeObserver(layout);
      entries.forEach(entry => this.observer!.observe(entry));
    }

    disconnectedCallback() {
      this.observer?.disconnect();
    }
  }

  if (!customElements.get('photo-masonry')) customElements.define('photo-masonry', PhotoMasonry);
</script>
<style>
  photo-masonry { display: block; }
  .photo-list { --photo-gap: 32px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; gap: var(--photo-gap) 24px; padding: 0; margin: 0; list-style: none; }
  .photo-list.is-masonry { grid-auto-rows: 1px; row-gap: 0; margin-bottom: calc(-1 * var(--photo-gap)); }
  .photo-list li { min-width: 0; }
  .photo-entry { display: block; border-radius: 12px; }
  .photo-frame { padding: 7px; border-radius: 12px; background: #fff; box-shadow: var(--surface-edge-shadow); }
  .photo-frame img { width: 100%; height: auto; border-radius: 6px; }
  .photo-caption { padding-top: 12px; }
  time { display: block; margin-top: 4px; color: var(--muted); font-size: .75rem; line-height: 1.5; }
  h2 { font-size: .9375rem; line-height: 1.6; font-weight: 550; overflow-wrap: anywhere; }
  @media (max-width: 479px) {
    .photo-list { --photo-gap: 24px; column-gap: 14px; }
    .photo-frame { padding: 5px; border-radius: 10px; }
    .photo-frame img { border-radius: 5px; }
    .photo-caption { padding-top: 10px; }
    time { font-size: .6875rem; }
    h2 { font-size: .8125rem; }
  }
</style>
