---
import WorkVisual from './WorkVisual.astro';
import type { Work } from '../lib/collections';
import { linkProps } from '../lib/links';
interface Props { work: Work; }
const { work } = Astro.props;
---
<a class="work-print" {...linkProps(work.url)} aria-label={work.title} style={`--work-ratio:${work.width}/${work.height}`}><WorkVisual image={work.image} width={work.width} height={work.height} sizes="(max-width: 540px) 45vw, 320px" /></a>
<style>
  .work-print { display: block; width: 100%; aspect-ratio: var(--work-ratio); container-type: inline-size; }
  @media (max-width: 540px) { .work-print { aspect-ratio: 1; } }
</style>
