---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { Icon } from 'astro-icon/components';
import { getPosts } from '../../lib/posts';
import { postDescription, displayDate } from '../../lib/post-data';
import '../../styles/prose.css';
export const getStaticPaths = (async () => {
  return (await getPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;
const { post } = Astro.props;
const { Content } = await render(post);
---
<SiteLayout title={post.data.title} description={postDescription(post)} articleDate={post.data.pubDate.toISOString()} breadcrumbs={[{ label: '笔记', href: '/posts/' }, { label: post.data.title }]}>
  <article>
    <header class="page-heading detail-heading">
      <h1>{post.data.title}</h1>
      <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{displayDate(post.data.pubDate)}</time>
    </header>
    <div class="prose"><Content /></div>
    <div class="article-end"><a class="back-link" href="/posts/"><Icon is:inline aria-hidden="true" focusable="false" name="ph:arrow-left" />返回笔记列表</a></div>
  </article>
</SiteLayout>
<style>
  .article-end { margin-top: 53px; padding-top: 26px; border-top: 1px solid var(--line); }
</style>
