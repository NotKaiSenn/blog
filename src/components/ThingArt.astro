---
import { Icon } from 'astro-icon/components';
import type { Region } from 'sharp';
import { croppedImage, responsiveImage } from '../lib/upload-variants';
import type { Thing } from '../lib/collections';
interface Props { thing: Thing & { crop?: Region }; sizes: string; eager?: boolean; }
const { thing, sizes, eager = false } = Astro.props;
const picture = thing.image && thing.crop
  ? croppedImage(thing.image, thing.crop, sizes)
  : { src: thing.image, ...responsiveImage(thing.image, thing.width, sizes) };
---
<div class="thing-art">
  {thing.image
    ? <img {...picture} alt="" width={thing.width} height={thing.height} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    : <Icon is:inline aria-hidden="true" focusable="false" name="ph:cube" class="thing-placeholder" />}
</div>
<style>
  /* Things are photographed as cutouts, so each one sits in a box of the same height and keeps its own shape. */
  .thing-art { display: flex; align-items: center; justify-content: center; height: 100%; }
  img { width: auto; max-width: 100%; height: auto; max-height: 100%; min-width: 0; min-height: 0; object-fit: contain; filter: drop-shadow(0 1px 1px #29322816) drop-shadow(0 6px 8px #2932281a); }
  .thing-art :global(.thing-placeholder) { width: 40%; max-width: 64px; height: auto; color: #a3a3a3; }
</style>
