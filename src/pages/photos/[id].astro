---
import type { GetStaticPaths } from 'astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { Icon } from 'astro-icon/components';
import type { Photo } from '../../lib/collections';
import { photos } from '../../lib/photos';
import { displayDate } from '../../lib/post-data';

export const getStaticPaths = (() => photos.map(photo => ({ params: { id: photo.id }, props: { photo } }))) satisfies GetStaticPaths;
interface Props { photo: Photo }
const { photo } = Astro.props;
---
<SiteLayout title={photo.title} description={photo.description ?? photo.alt} breadcrumbs={[{ label: '照片', href: '/photos/' }, { label: photo.title }]} wide>
  <article class="photo-detail">
    <header class="page-heading detail-heading"><h1>{photo.title}</h1><time datetime={photo.date}>{displayDate(new Date(`${photo.date}T00:00:00Z`))}</time></header>
    <figure>
      <div class="photo-frame"><img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} decoding="async" /></div>
      {photo.description && <figcaption>{photo.description}</figcaption>}
    </figure>
    <div class="photo-return"><a class="back-link" href="/photos/"><Icon is:inline aria-hidden="true" focusable="false" name="ph:arrow-left" />返回照片</a></div>
  </article>
</SiteLayout>
<style>
  figure { margin: 0; }
  .photo-frame { padding: 9px; border-radius: 14px; background: #fff; box-shadow: 0 2px 5px #2633210a, 0 12px 26px #2633210a; }
  img { width: 100%; height: auto; border-radius: 5px; }
  figcaption { margin-top: 22px; color: var(--body); font-size: .9375rem; line-height: 1.9; white-space: pre-line; overflow-wrap: anywhere; }
  figcaption, .photo-return { width: min(640px, 100%); margin-inline: auto; }
  .photo-return { margin-top: 35px; }
</style>
